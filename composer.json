{
    "name": "componenta/var-export",
    "description": "Generate deterministic executable PHP expressions for scalars, arrays, closures, enums, and explicitly enabled readonly value objects",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "var-export",
        "code-generation",
        "closure",
        "configuration-cache",
        "php-code"
    ],
    "authors": [
        {
            "name": "Componenta",
            "email": "dev@Componenta.io"
        }
    ],
    "homepage": "https://github.com/componenta/var-export",
    "support": {
        "issues": "https://github.com/componenta/var-export/issues",
        "source": "https://github.com/componenta/var-export"
    },
    "require": {
        "php": "^8.4",
        "nikic/php-parser": "^5.8"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "pestphp/pest": "^4.0",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Componenta\\VarExport\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Componenta\\VarExport\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "pest",
        "test-coverage": "pest --coverage --min=90",
        "mutation": "pest --mutate --everything --parallel --covered-only --min=70 --compact",
        "phpstan": "phpstan analyse src --level=max",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "check": [
            "@cs-check",
            "@phpstan",
            "@test"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-main": "2.x-dev"
        }
    }
}
